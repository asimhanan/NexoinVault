<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1A000000"> <!-- Subtle click ripple -->

    <!-- Outer Soft Shadow Layer -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#12000000" /> <!-- Faint dark shadow tint -->
        </shape>
    </item>

    <!-- Main Button Body (Inset slightly to reveal the shadow around edges) -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <!-- Semi-transparent white gives that glossy/glass look over the background -->
            <solid android:color="#F0FFFFFF" />
        </shape>
    </item>

</ripple>
